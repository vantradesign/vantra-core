{
  "name": "@vantradesign/core",
  "version": "0.0.0",
  "description": "Shared AST parsing, component-graph and design-token primitives for the Vantra design-system governance suite.",
  "keywords": [
    "design-system",
    "governance",
    "ast",
    "ts-morph",
    "design-tokens",
    "component-graph",
    "vue",
    "react"
  ],
  "license": "AGPL-3.0-only",
  "author": "Vantra Design <vantra@kauper.co>",
  "homepage": "https://github.com/vantradesign/vantra-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantradesign/vantra-core.git"
  },
  "bugs": {
    "url": "https://github.com/vantradesign/vantra-core/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.41",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.26",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
